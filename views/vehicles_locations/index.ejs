<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vehicle Locations</title>
  <link href="/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <h1>Vehicle Locations</h1>
    <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Vehicle</th>
          <th>Location</th>
        </tr>
      </thead>
      <tbody>
        <% if (vehicleLocations && vehicleLocations.length) { %>
          <% vehicleLocations.forEach(vl => { %>
            <tr>
              <td><%= vl.vehicleLocationID %></td>
              <td><%= vl.model %> (<%= vl.vehicleID %>)</td>
              <td><%= vl.locationName %> (<%= vl.locationID %>)</td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-muted">No vehicle-location assignments found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <h2>Update Vehicle Location</h2>
    <form action="/vehicles_locations" method="post">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="vehicleID" class="form-label">Vehicle</label>
          <select id="vehicleID" name="vehicleID" class="form-select" required>
            <option value="">-- select vehicle --</option>
            <% vehicles.forEach(vehicle => { %>
              <option value="<%= vehicle.vehicleID %>"><%= vehicle.model %> (<%= vehicle.year %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label for="locationID" class="form-label">Location</label>
          <select id="locationID" name="locationID" class="form-select" required>
            <option value="">-- select location --</option>
            <% locations.forEach(loc => { %>
              <option value="<%= loc.locationID %>"><%= loc.locationName %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Update</button>
    </form>
  </div>
  <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>
