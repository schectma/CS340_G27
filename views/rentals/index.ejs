<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rentals</title>
  <link href="/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <%- include('../partials/navbar') %>
    <div class="container mt-4">
      <h1>Rentals</h1>
      <a href="/rentals/new" class="btn btn-primary mb-3">New Rental</a>
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Vehicle</th>
            <th>Customer</th>
            <th>Pickup Location</th>
            <th>Dropoff Location</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Total Cost</th>
            <th>Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% rentals.forEach(rental=> { %>
            <tr>
              <td>
                <%= rental.rentalID %>
              </td>
              <td>
                <%= rental.vehicleModel || rental.vehicleID %>
              </td>
              <td>
                <%= rental.customerName || rental.customerID %>
              </td>
              <td>
                <%= rental.pickupLocationName || rental.pickupLocationID %>
              </td>
              <td>
                <%= rental.dropoffLocationName || rental.dropoffLocationID %>
              </td>
              <td>
                <%= rental.startDate %>
              </td>
              <td>
                <%= rental.endDate %>
              </td>
              <td>
                <%= rental.totalCost %>
              </td>
              <td>
                <%= rental.isActive ? 'Yes' : 'No' %>
              </td>
              <td><a href="/rentals/delete/<%= rental.rentalID %>" class="btn btn-danger btn-sm">Delete</a></td>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>